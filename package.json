  },
  "license": "MIT",
  "author": "CleanTalk (https://cleantalk.org)",
  "main": "dist/ct_checkjs.js",
  "browser": "dist/ct_checkjs.js",
  "types": "dist/ct_checkjs.d.ts",
  "unpkg": "dist/ct_checkjs.js",
  "jsdelivr": "dist/ct_checkjs.js",
  "sideEffects": true,
